<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
      Two appenders are provided. The default console appender is human-readable
      for local development. Set LOG_FORMAT=json (production) to emit structured
      JSON via the Logstash encoder for log aggregation.

      IMPORTANT: the appender names MUST match the possible LOG_FORMAT values
      ("text" / "json", lowercase) because the root logger references the
      appender by `${LOG_FORMAT}`. A case mismatch leaves the root logger with
      no appender attached, which silently suppresses ALL application logs.
    -->
    <property name="LOG_FORMAT" value="${LOG_FORMAT:-text}"/>

    <appender name="text" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="json" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>requestId</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <includeMdcKeyName>clientId</includeMdcKeyName>
        </encoder>
    </appender>

    <root level="${LOG_LEVEL:-INFO}">
        <appender-ref ref="${LOG_FORMAT}"/>
    </root>

    <logger name="io.netty" level="INFO"/>
    <logger name="org.eclipse.jetty" level="INFO"/>
    <logger name="Exposed" level="INFO"/>
    <logger name="com.zaxxer.hikari" level="INFO"/>
</configuration>
