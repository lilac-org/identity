# =====================================================================
# Identity service configuration. Copy to `.env` and fill in real values.
# Anything left unset falls back to the development defaults in ConfigLoader.
# =====================================================================

# ---- HTTP server ----------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
APP_NAME=Identity
FRONTEND_BASE_URL=http://localhost:8080
# Comma-separated CORS hosts; "*" allows any host (development only).
CORS_ALLOWED_HOSTS=*
SWAGGER_ENABLED=true
ADMIN_DASHBOARD_ENABLED=true
# Set true in production when running behind a reverse proxy (nginx/caddy/traefik)
# so X-Forwarded-* headers are honored (correct scheme/host for OAuth redirect URIs).
BEHIND_PROXY=false
# Set true in production (HTTPS) so the admin-dashboard cookie is sent over HTTPS only.
COOKIE_SECURE=false

# ---- Logging --------------------------------------------------------
# text (human readable) or json (structured / production)
LOG_FORMAT=text
LOG_LEVEL=INFO

# ---- Database -------------------------------------------------------
DB_JDBC_URL=jdbc:postgresql://localhost:5433/identity
DB_USERNAME=identity
DB_PASSWORD=identity
DB_NAME=identity
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2
DB_RUN_MIGRATIONS=true

# ---- JWT signing (RS256 + JWKS) -------------------------------------
# Provide keys EITHER inline (PEM with literal \n) OR via file paths.
# Generate a key pair:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
# JWT_PRIVATE_KEY_PEM=
# JWT_PUBLIC_KEY_PEM=
JWT_KEY_ID=identity-key-1
JWT_ISSUER=identity
JWT_DEFAULT_AUDIENCE=identity

# ---- Token lifetimes ------------------------------------------------
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
SERVICE_TOKEN_TTL_MINUTES=15
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1

# ---- Email ----------------------------------------------------------
# Provider: LOG (dev, prints to console) | RESEND | SMTP
EMAIL_PROVIDER=LOG
EMAIL_FROM_ADDRESS=no-reply@identity.local
EMAIL_FROM_NAME=Identity
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# ---- OAuth providers (optional) -------------------------------------
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=

# ---- Rate limiting (implemented but disabled by default) ------------
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=60
